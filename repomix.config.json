{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "style": "xml",
    "removeComments": false,
    "removeEmptyLines": false
  },
  "ignore": {
    "useDefaultPatterns": false,
    "useGitignore": true,
    "customPatterns": [
      ".git/**",
      "target/**",
      "data/**",
      ".venv/**",
      "**/__pycache__/**",
      "**/*.pyc",
      "evidence/**",
      "docs/cycles/{TASKS,PROGRESS}-v0.{8,9,10,11}*",
      "repomix-output-*.xml"
    ]
  },
  "security": {
    "enableSecurityCheck": false
  }
}
