# intel-platform local model configuration
#
# Copy this file to .env, fill only local values, and keep .env uncommitted.
# `./run` loads .env automatically. Never put real keys in this example file.

# Required whenever `cored` is built with `--features net`. Supply a real
# monitored email address or contact URL; startup refuses an unset/empty value
# and the placeholders `example.com`, `you@`, and `changeme`.
INTEL_CRAWLER_CONTACT=

# Deliberate `/view` benchmark diagnostic. Set the stage to one of
# sector_load, analysis, response_build, or serialization and the delay in
# milliseconds. The core clamps the delay to 10000 ms and emits a startup
# warning naming both settings whenever either variable is set. Leave both
# unset outside an intentional diagnostic run.
# CORE_VIEW_DIAGNOSTIC_DELAY_STAGE=
# CORE_VIEW_DIAGNOSTIC_DELAY_MS=0

# Select the chat profile used by `./run verify-llm`: lan or online.
# Leave blank to use LLM_CHAT_BASE_URL (or the legacy LLM_BASE_URL).
# LLM_CHAT_PROFILE=lan

# LAN chat profile. The server must implement POST /v1/chat/completions.
# LLM_LAN_BASE_URL=http://192.168.0.192:8080/v1
# LLM_LAN_API_KEY=
# LLM_LAN_CHAT_MODEL=

# Online chat profile. DeepSeek is chat-compatible but does not provide the
# POST /v1/embeddings route, so do not reuse it as LLM_EMBED_BASE_URL.
# LLM_ONLINE_BASE_URL=https://api.deepseek.com/v1
# LLM_ONLINE_API_KEY=
# LLM_ONLINE_CHAT_MODEL=deepseek-chat

# Independent embedding provider. This endpoint MUST implement
# POST /v1/embeddings and return OpenAI-compatible embedding objects.
# LLM_EMBED_BASE_URL=https://embedding-provider.example/v1
# LLM_EMBED_API_KEY=
LLM_EMBED_MODEL=replace-with-provider-model-name
# Last dimension measured from this exact model identity. The provider probe
# refuses to infer or silently update it.
# LLM_EMBED_EXPECTED_DIMENSION=

# Optional direct chat configuration when LLM_CHAT_PROFILE is blank.
# LLM_CHAT_BASE_URL=
# LLM_CHAT_API_KEY=
# LLM_CHAT_MODEL=

# Bound provider waits. Per-role values override the shared legacy fallback.
LLM_CHAT_TIMEOUT_SECONDS=30
LLM_EMBED_TIMEOUT_SECONDS=30
# LLM_TIMEOUT_SECONDS=30

# Keep machine-specific tunnel aliases out of this file. When the command
# runner cannot route the configured provider endpoints, apply transport-only
# aliases to one invocation:
# LLM_CHAT_TRANSPORT_BASE_URL=http://127.0.0.1:<chat-port> \
# LLM_EMBED_TRANSPORT_BASE_URL=http://127.0.0.1:<embedding-port> \
# LLM_EMBED_EXPECTED_DIMENSION=<last-measured-width> ./run probe-providers

# Backward-compatible one-provider configuration. Prefer the split variables
# above; these remain supported for a provider that implements both APIs.
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# The Rust core is loopback-internal. Keep localhost out of system proxies.
# Add your LAN model host if your proxy configuration would otherwise capture it.
NO_PROXY=127.0.0.1,localhost
no_proxy=127.0.0.1,localhost
